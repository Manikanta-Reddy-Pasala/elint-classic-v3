# AIForge dossier artifacts (generated on read — not code changes)
.dossier.json
dossier.md
ticket.md
page.md
confluence-*.md
jira-*.md
attachments/

# Python
__pycache__/
*.pyc
.venv/
bin/

# Run logs
*.log

# Rust build artifacts
/target/
cargo-target/

# Go build artifacts
*.exe
*.test

# e2e local run state (keep source, drop runtime state)
e2e_local/logs/
e2e_local/pids/
e2e_local/t0.txt
e2e_local/writer/writer-bin
e2e_local/__pycache__/
e2e_local/writer/__pycache__/

# Tooling / working dirs
.codegraph/
.cargo/
analysis/
target/

# Root Cargo.lock: engine pins its own lock file; the root lock would be
# regenerated as version 4 by modern cargo, which old cargo (1.75) cannot parse.
# Keep the v4 copy in the tree as Cargo.lock.v4-unused for reference.
/Cargo.lock
bin/
engine/ort.so

# Test CSV corpus (8.9G, 448 known + 160 unknown) - kept on disk, not in git
/data/pdw_generator/

# --- elint-classic-v3 additions ---
# source binaries under pipeline/src/bin are code (the bin/ rule above is for build output)
!pipeline/src/bin/
# never add data, results, models or runtime binaries
*.csv
*.tsv
*.jsonl
*.onnx
*.ort
*.mxr
*.whl
ort.so
migraphx_cache/
.cargo-cache/
results/
synth*/
dfmix*/
primix*/
unseen*/

# elint.sh runtime state (pids, logs, judge output) and local venvs
.run/
onnx_model_service/.gpu
onnx_model_service/model/
ai_elint_tests/data/
ai_elint_tests/*.pdf
ai_elint_tests/*.png
ai_elint_tests/allure-results/
