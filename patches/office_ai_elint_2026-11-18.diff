+    let bins: Vec<i64> = t.windows(2).map(|w| ((w[1].0 - w[0].0).max(1.0).ln() / lb).round() as i64).collect();
+    let mut h: HashMap<i64, usize> = HashMap::new();
+    for b in &bins {
