#!/usr/bin/env bash

commit_msg_file="$1"

subject="$(grep -v '^#' "$commit_msg_file" | grep -v '^[[:space:]]*$' | head -n 1)"

types="build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test"

pattern="^(${types})(\([a-z0-9._/ -]+\))?!?: .+"

if echo "$subject" | grep -qE "^(Merge|Revert) "; then
  exit 0
fi

if ! echo "$subject" | grep -qE "$pattern"; then
  echo "------------------------------------------------------------------"
  echo "❌  Invalid commit message!"
  echo ""
  echo "    Your subject line was:"
  echo "      \"$subject\""
  echo ""
  echo "    Commit messages must follow the Conventional Commits style:"
  echo "      <type>(optional scope): <description>"
  echo ""
  echo "    Allowed types:"
  echo "      build, chore, ci, docs, feat, fix, perf,"
  echo "      refactor, revert, style, test"
  echo ""
  echo "    Examples:"
  echo "      feat: add signal decoder"
  echo "      fix: correct off-by-one in parser"
  echo "      ci: update gitlab pipeline stages"
  echo "      refactor(utils): simplify path handling"
  echo "------------------------------------------------------------------"
  exit 1
fi

exit 0
