# AI ELINT Test Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git — only .env.example is tracked.

# --- Rust Engine Binary ---
# Path to the built ai_processor binary (cargo build --release output)
AI_ENGINE_BINARY=/home/sysadm/ai_elint_rust/target/release/ai_processor

# --- PostgreSQL ---
# The sigint database holding emitters, signals, clusters tables
PG_URL=postgresql://elint:elint@127.0.0.1:15432/sigint

# --- ClickHouse ---
# CH instance holding pdw, clusters, csv_input tables (database: signals)
CH_URL=http://127.0.0.1:18123

# --- ONNX Model ---
# Path to the transformer ONNX model used by the Rust engine
ONNX_PATH=/home/sysadm/ai_elint_rust/models/transformer_model_known_v16.onnx

# --- Test Data ---
# Root directory containing data/input_csv_files/pdw_generator/
TEST_DATA_ROOT=tests/data

# --- VM (for remote runs) ---
# SSH details for the VM where the engine and DBs are deployed
VM_HOST=10.10.120.13
VM_USER=sysadm
VM_PASS=
VM_WORKDIR=/home/sysadm/ai_elint_tests_work
